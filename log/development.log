  [1m[36mMovie Create (198.2ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "ペイ・ザ・ゴースト ハロウィンの生贄"], ["description", "大学で教えているマイクは、7歳の息子にせがまれハロウィンの祭り見物に出掛けるが、息子は「霊（ゴースト）に償ってくれる？」と不思議な言葉を残しこつぜんと姿を消す。必死に息子を捜し続けるマイクは、毎年ハロウィンに子供たちが行方不明になり、誰も見つかっていないという事実を突き止める。翌年のハロウィンが迫る中、マイクの周辺で奇怪な現象が起き始める。"], ["release_date", "2015-09-16"], ["poster_url", "https://image.tmdb.org/t/p/w500/dyZdiIH7Y8euKAzaKAV5ABXl0Vy.jpg"], ["tmdb_id", 290637], ["created_at", "2024-07-12 16:44:10.754883"], ["updated_at", "2024-07-12 16:44:10.754883"], ["overview", nil], ["poster_path", nil]]
