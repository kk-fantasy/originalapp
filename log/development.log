  [1m[36mMovie Create (197.0ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "マザー！"], ["description", "郊外で穏やかな暮らしを送っていた夫婦の家に、謎の男が訪ねてきた。妻はその男に不信感を抱いていたが、夫は快く迎え入れた。その日から、夫婦の家には代わる代わる訪問者がやってくるようになった。「このままでは何か良からぬことが起こる」という妻の訴えを真剣に取り上げようとしない夫だったが、彼女の不安はやがて現実のものとなった。"], ["release_date", "2017-09-13"], ["poster_url", "https://image.tmdb.org/t/p/w500/2yOKarmL8B4oXaLXUdHu882SUbu.jpg"], ["tmdb_id", 381283], ["created_at", "2024-07-12 16:44:40.980120"], ["updated_at", "2024-07-12 16:44:40.980120"], ["overview", nil], ["poster_path", nil]]
