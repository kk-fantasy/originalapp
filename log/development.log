  [1m[36mMovie Create (299.1ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "ゴジラ対ヘドラ"], ["description", "ゴジラシリーズ第11作。当時社会問題となっていた公害問題を前面に打ち出し、サイケデリックな映像を取り入れた異色作。ヘドロで汚された駿河湾の河口で巨大なオタマジャクシに似た生物が見つかり、さらには怪物によるタンカー事故が相次いで発生。海洋学者の矢野は、怪物がヘドロと宇宙鉱物から生まれた生命体であると推察する。謎の怪物ヘドラは主食であるヘドロを求めて工業地帯を襲撃し、次第に巨大な怪獣へと変貌していく。硫酸ミストをまき散らし深刻な公害被害により人々が次々と倒れていく中、富士山麓にてゴジラとの決戦が近づく。"], ["release_date", "1971-07-24"], ["poster_url", "https://image.tmdb.org/t/p/w500/onlkKgEWDOcKhxQO6P6T1bI62DL.jpg"], ["tmdb_id", 39464], ["created_at", "2024-07-12 18:00:30.300843"], ["updated_at", "2024-07-12 18:00:30.300843"], ["overview", nil], ["poster_path", nil]]
