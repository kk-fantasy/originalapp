  [1m[36mMovie Create (616.7ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "ドント・ブリーズ"], ["description", "親元を離れ、街から逃げ出すための資金が必要なロッキーは、恋人のマニーと友人のアレックスとともに、地下に大金を隠し持っていると噂される盲目の老人の家に強盗に入る。しかし、その老人は目が見えないかわりに、どんな音も聴き逃さない超人的な聴覚をもち、さらには想像を絶する異常な本性を隠し持つ人物だった。暗闇に包まれた家の中で追い詰められたロッキーたちは、地下室にたどり着くが、そこで恐るべき光景を目の当たりにする。"], ["release_date", "2016-06-08"], ["poster_url", "https://image.tmdb.org/t/p/w500/iKy9KSYskg1dLb87IWd0ZWjzl2f.jpg"], ["tmdb_id", 300669], ["created_at", "2024-07-12 16:23:57.947054"], ["updated_at", "2024-07-12 16:23:57.947054"], ["overview", nil], ["poster_path", nil]]
