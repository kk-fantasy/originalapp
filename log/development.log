  [1m[36mMovie Create (222.0ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "ファイナル・デッドブリッジ"], ["description", "主人公のサムたちは会社の研修旅行の中、工事が続いている巨大な吊り橋をバスで渡ろうとしていた。 その瞬間、サムは自然災害により突如として橋が崩れ落ち、同僚や上司が次々と死んでいく凄惨な予知夢を見る。 パニックに陥ったサムは周りに危険を知らせると、恋人モリーを連れ橋から避難、彼らを含め8人の社員が奇跡的に事故から生き延びる。 ところが、それは新たな惨劇の始まりであった･･･。"], ["release_date", "2011-08-12"], ["poster_url", "https://image.tmdb.org/t/p/w500/3cA207pKMvtC5paFHl69aFHN4uR.jpg"], ["tmdb_id", 55779], ["created_at", "2024-07-12 16:23:09.921623"], ["updated_at", "2024-07-12 16:23:09.921623"], ["overview", nil], ["poster_path", nil]]
