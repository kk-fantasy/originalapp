  [1m[36mMovie Create (198.2ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "ミスミソウ"], ["description", "半年前、父親の仕事の都合で東京の学校から大津馬村[注 2]の大津馬中学校に転校して来た野咲春花は、クラスメイトからの壮絶なイジメに遭っていた。春花は家族に心配を掛けまいとイジメに遭っていることを隠し、中学校卒業までの残り2カ月間を必死に耐えようとするが、春花へのイジメは悪化の一途を辿るばかり。遂にイジメを知った家族の勧めで春花が登校拒否を行ったある日、イジメっ子達が彼女の家に乗り込み両親と妹に危害を加え、家を放火するという事件が起こる。春花の妹・祥子は大火傷を負いながらも助かったが、両親は命を落としてしまった。やがて事件の真相が露見することを恐れたイジメっ子達は春花に自殺するよう強要。だが、それがきっかけとなって春花は事件の真相を知り、家族を奪ったイジメっ子達に己の命を賭けた凄惨な復讐を開始する。"], ["release_date", "2018-04-07"], ["poster_url", "https://image.tmdb.org/t/p/w500/36s4VPYjrj99vE5tiR4Q1quXuZG.jpg"], ["tmdb_id", 498934], ["created_at", "2024-07-12 18:02:47.411377"], ["updated_at", "2024-07-12 18:02:47.411377"], ["overview", nil], ["poster_path", nil]]
