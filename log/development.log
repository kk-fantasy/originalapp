  [1m[36mMovie Create (242.9ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "遊星からの物体X ファーストコンタクト"], ["description", "ノルウェーの南極観測隊が、氷の中に閉じ込められた未知の生命体を発見。古代の生物ではないかと推測され、その調査のために考古生物学者ケイトが彼らの基地に向かう。だが、生命体は解凍されて長い眠りから覚醒。しかも、それはほかの生物の体内に侵入しては、細胞を同化して宿主そのものに擬態する、宇宙からやって来た生命体だったのだ。突如として宿主の肉体を破壊するように変形しては襲い掛かる生命体によって、彼らは誰が同化されているのか判断できない状況になっていき……。"], ["release_date", "2011-10-12"], ["poster_url", "https://image.tmdb.org/t/p/w500/2Ejt7G1QCGOp8BL7vGEuQnS3Xg.jpg"], ["tmdb_id", 60935], ["created_at", "2024-07-12 17:59:47.899044"], ["updated_at", "2024-07-12 17:59:47.899044"], ["overview", nil], ["poster_path", nil]]
