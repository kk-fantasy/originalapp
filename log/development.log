  [1m[36mMovie Create (198.4ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "女教師 生徒の眼の前で"], ["description", "女教師・令子の美しさに男子生徒の欲望は爆発寸前。ついに更衣室で何者かにレイプされた令子の目に留まったのは1片のジグゾーパズル。それだけを手がかりに彼女は犯人を自ら捜査。不良生徒に疑惑の目を向けるのだったが…"], ["release_date", "1982-04-09"], ["poster_url", "https://image.tmdb.org/t/p/w500/rwGW7zhFKaojtJiSMnoLyVkKZnx.jpg"], ["tmdb_id", 173705], ["created_at", "2024-07-12 16:50:00.023409"], ["updated_at", "2024-07-12 16:50:00.023409"], ["overview", nil], ["poster_path", nil]]
