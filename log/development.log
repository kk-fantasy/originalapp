  [1m[36mMovie Create (197.4ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "死霊のはらわた"], ["description", "休暇を過ごす為、アッシュは恋人シェリルと妹や友人と共に森深くたたずむ別荘にやって来る。\r 暖炉を囲みながら夜更けまで楽しく過ごす若者たち。退屈しのぎに別荘の地下室に入りそこで見つけた\r 古いテープレコーダーを再生すると、そこからはかつて別荘の住人だった学者の古文書解読の経緯を\r 伝える音声が流れてくる。古文書の呪文の一節を朗読するその音声は唱えてはならない古代の死霊を\r 呼び出す禁句であった。薄気味の悪いテープの内容にナーバスになるアッシュの妹だったが、次の瞬間\r 愛らしい妹は恐ろしい形相になり、宙に浮かびながら死霊を呼び覚ました全員を皆殺しにすると吐き捨て\r 襲いかかってくる。死霊にとりつかれた妹をいさめるにはもはや地下室に閉じ込めるしかなく、その間\r アッシュはテープから流れていた死霊から逃れる方法を思い出していた。その方法とはとりつかれた者\r の体をバラバラに裂くしかないというものであった・・。思い悩むアッシュ達をあざ笑うように死霊達\r は仲間に次々と憑依してゆく。"], ["release_date", "1981-09-10"], ["poster_url", "https://image.tmdb.org/t/p/w500/gTsKui7FOkZxAU8LSDmbkd6Tn5H.jpg"], ["tmdb_id", 764], ["created_at", "2024-07-12 16:24:59.999021"], ["updated_at", "2024-07-12 16:24:59.999021"], ["overview", nil], ["poster_path", nil]]
