  [1m[36mMovie Create (198.1ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "美女のはらわた"], ["description", "ある倉庫、四人の男達に取り囲まれ、壁の方に追い詰められた娘・伊藤良美が必死の表情で恐怖に耐えている。ドアの前には一山会のNo.2吉岡雄二が立っている。「娘を犯れ」その言葉で全員の視線が良美にいく。吉岡が東に命じる、「やれよ、エンジェルレイン」。とまどいながらも、注射器セットを出した東は、黄色い液体をポンプ内に吸引した。苦痛と絶望の入り混じった瞳で、液体が流し込まれている左腕を見ている。いきなり肉体が変調をきたしだす...。"], ["release_date", "1986-09-23"], ["poster_url", "https://image.tmdb.org/t/p/w500/3bAstAPpt3E5dslgLOhbftZTLeN.jpg"], ["tmdb_id", 39858], ["created_at", "2024-07-12 18:00:16.133713"], ["updated_at", "2024-07-12 18:00:16.133713"], ["overview", nil], ["poster_path", nil]]
