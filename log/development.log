  [1m[36mMovie Create (200.1ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "黒執事"], ["description", "犯罪組織が若い女性を多数さらい監禁する倉庫内で、その組織を探る一人の少女が構成員に追及される。そこへ現れた彼女の執事は、十数名の敵を一人であっさりと殺害して彼女を救いだす。銃で撃たれても全く傷つかないこの男・セバスチャンの正体は悪魔で、彼の主人である幻蜂伯爵家の若き当主・清玄こと男装した少女の汐璃が幼い頃両親を目の前で殺害されたとき以来、死の際にその魂を食らうことと引き換えに契約を結び仕えている。映画の舞台となる2020年では、世界は西側と東側に別れ、西側を治める女王は東側某国の幻蜂家に命じて公にできないさまざまな事件を「処理」しており、彼らは当局に正体不明の「女王の番犬」として警戒されている。清玄は女王の命により、セバスチャンと共に大使館員が次々にミイラ化した遺体で発見されるという怪事件を追いつつ、いつか両親の敵を討つことを願っている。"], ["release_date", "2014-01-18"], ["poster_url", "https://image.tmdb.org/t/p/w500/rovMq8yoJA8TOAKvRZm3amRa8Hn.jpg"], ["tmdb_id", 220447], ["created_at", "2024-07-12 18:15:20.536328"], ["updated_at", "2024-07-12 18:15:20.536328"], ["overview", nil], ["poster_path", nil]]
