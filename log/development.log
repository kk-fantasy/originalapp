  [1m[36mMovie Create (197.1ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "アンダーワールド 覚醒"], ["description", "狼男族だけでなく、仲間である吸血鬼族からも追われる身となった後に、人間に捕まってしまった女戦士セリーン。12年もの眠りから覚醒した彼女は、その間にも収束することのなかった吸血鬼族と狼男族の戦いに、両種族の能力を奪おうと人間が加わっている混沌を極めた状況を目の当たりにする。吸血鬼族、狼男族、人間が入り乱れる壮絶な戦闘の最中に、セリーンは戦いの行方を大きく左右する存在となる少女と出会う。"], ["release_date", "2012-01-19"], ["poster_url", "https://image.tmdb.org/t/p/w500/85OLA2mcjqH9v59C9aB5QvXpQmN.jpg"], ["tmdb_id", 52520], ["created_at", "2024-07-12 16:45:54.356636"], ["updated_at", "2024-07-12 16:45:54.356636"], ["overview", nil], ["poster_path", nil]]
