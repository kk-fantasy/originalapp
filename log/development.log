  [1m[36mMovie Create (197.5ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "デスノート Light up the NEW world"], ["description", "デスノートの力で多数の凶悪犯を破滅させた夜神月と、彼を追い詰めた天才Lの伝説のバトルから10年の歳月が経過。またしても死神がデスノートを下界にまき散らしたため、世界中が混乱していた。夜神総一郎が設立したデスノート対策本部は健在で、キラ事件を熟知する三島をはじめとする特別チームが事態を注視しており……。"], ["release_date", "2016-10-29"], ["poster_url", "https://image.tmdb.org/t/p/w500/kdqVPMK4ePJZHfDQwgKWvAjbaRI.jpg"], ["tmdb_id", 382272], ["created_at", "2024-07-12 16:45:13.453831"], ["updated_at", "2024-07-12 16:45:13.453831"], ["overview", nil], ["poster_path", nil]]
