  [1m[36mMovie Create (197.7ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "ファニーゲーム"], ["description", "ある夏の午後、ショーバー一家は休暇を過ごすためにレンジローバーでクラシック音楽のクイズをしながら別荘に向かっていた。途中、隣人のベーリンガーと挨拶をかわす。そこには白いシャツと白いズボン、白い手袋を身に着けた2人組の見知らぬ男たちがいた。\r 別荘につくと妻アンナは夕食の支度に取りかかり、夫ゲオルクと息子は明日のセーリングの準備をはじめる。そこに、ベーリンガーの所にいた2人組の男のうちの1人が、卵がなくなったので譲ってほしいとアンナに話しかけてきた。\r アンナはそれを受け入れて卵を渡すが、男は2度も落として割ってしまう。そして3度目の訪問時、態度を見かねたゲオルグに平手打ちを食わされた途端に男の態度は豹変し、近くにあったゴルフクラブでゲオルクの脚を殴りつけ、一家全員をソファーに縛り付ける。2人は悪びれた態度を微塵も見せず、くつろぐように家を占領し続けた。\r 夜になると、2人は一家に「明日の朝まで君たちが生きていられるか賭けをしないか?」と持ち掛ける。\r こうして、残酷でおぞましいゲームの幕開けが告げられた。"], ["release_date", "1997-08-23"], ["poster_url", "https://image.tmdb.org/t/p/w500/rlbznhqKycQkWw9agSO5vadTHWJ.jpg"], ["tmdb_id", 10234], ["created_at", "2024-07-12 18:05:39.750530"], ["updated_at", "2024-07-12 18:05:39.750530"], ["overview", nil], ["poster_path", nil]]
