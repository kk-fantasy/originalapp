  [1m[36mMovie Create (199.3ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "ドラゴンボール 魔神城のねむり姫"], ["description", "亀仙人に弟子入りして稽古をつけて貰おうと、はるばるカメハウスまでやって来た孫悟空。同じ日、坊主頭の少年クリリンも弟子入りを目的にカメハウスまでやってくる。亀仙人は双方に弟子入りするための条件として、西の果てにある魔神城で数千年間眠り続けているという美女「ねむり姫」を連れてくることを提示する。早速自分が弟子入りを果たそうと、競い合いながら魔神城へ向かう2人。  その後久々に悟空に会いに来たブルマたちは、「スケベなお使い」を隠したい亀仙人から、悟空の行き先は遊園地だと伝えられる。一行は事実を知らないまま、遊園地があると聞かされた魔神城の方角へ悟空を追っていくのであった。  そしてその頃、金髪の謎の女性ランチも、「ねむり姫」のことを知り魔神城へと向かっていた。"], ["release_date", "1987-07-18"], ["poster_url", "https://image.tmdb.org/t/p/w500/fxKP02OXzS3eCAzrZNzd03sEDi6.jpg"], ["tmdb_id", 39145], ["created_at", "2024-07-12 16:45:39.294466"], ["updated_at", "2024-07-12 16:45:39.294466"], ["overview", nil], ["poster_path", nil]]
  [1m[36mTRANSACTION (197.9ms)[0m  [1m[35mCOMMIT[0m
  [1m[36mMovie Exists? (197.8ms)[0m  [1m[34mSELECT 1 AS one FROM "movies" WHERE "movies"."tmdb_id" = $1 LIMIT $2[0m  [["tmdb_id", 10781], ["LIMIT", 1]]
