  [1m[36mTRANSACTION (196.9ms)[0m  [1m[35mBEGIN[0m
  [1m[36mMovie Exists? (395.9ms)[0m  [1m[34mSELECT 1 AS one FROM "movies" WHERE "movies"."tmdb_id" = $1 LIMIT $2[0m  [["tmdb_id", 38321], ["LIMIT", 1]]
  [1m[36mMovie Create (197.2ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "プリースト"], ["description", "ヴァンパイアとの戦いで荒廃した未来、人類は高い壁に囲まれた城塞都市で修道会の支配のもとで暮らす。ある日、修道会の戦士《プリースト》の一員である男のもとに、兄の家族がヴァンパイアに襲われ、幼いめいがさらわれたとの知らせが届く。プリーストは、安全なはずの都市に再びヴァンパイアの脅威が訪れたことを訴えるが、修道会は聞く耳を持たない。プリーストはめいを救うため、やむなく掟を破って都市の外へと旅立つ。"], ["release_date", "2011-05-05"], ["poster_url", "https://image.tmdb.org/t/p/w500/3TwUhjdEyIDE5onJkb1y01JcpoX.jpg"], ["tmdb_id", 38321], ["created_at", "2024-07-12 16:51:02.084914"], ["updated_at", "2024-07-12 16:51:02.084914"], ["overview", nil], ["poster_path", nil]]
