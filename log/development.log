  [1m[36mMovie Create (197.6ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "アムリタの饗宴"], ["description", "郊外の工場跡地に建つ巨大集合住宅。\r 最近では、女子高生の変死体が発見され、不可解な心霊現象が目撃されるなど、いわくつきの噂が絶えない場所だった。\r ここに引っ越してきた、気弱な女子大生りんは、ある夜、救急車で搬送される老婆の腕から大きな虫が飛び出るのを目撃する。\r 虫のことが気になったりんは図書室で調べる内、民俗学者の時世と出会い、過去にもこの地域で、奇妙な虫の目撃例が多発していたことを知る。\r それは“心霊蟲（しんれいちゅう）”と呼ばれ、古来から人知れず存在していたという。 “虫”を見た者の中には、不気味な予兆と共に、変死を遂げた者も少なくないため、“虫の呪い”ともいわれた。\r 呪いの恐怖におびえる彼女は、不思議なオーラを放つ中学生、奈澄葉や、呪術師の斉恩らとの出会いを通して、自らも蟲や怪異の正体に迫っていく。  しかし、それはりん自身が、封印された過去と向き合うことを意味していた……。  果たして、りんを待ち受ける運命とは!?　そして建物に隠された驚愕の真実とは!?"], ["release_date", "2023-05-26"], ["poster_url", "https://image.tmdb.org/t/p/w500/eHt9KnmZDQBiEnhk7hoYcKxCiwX.jpg"], ["tmdb_id", 725064], ["created_at", "2024-07-12 16:49:11.305375"], ["updated_at", "2024-07-12 16:49:11.305375"], ["overview", nil], ["poster_path", nil]]
