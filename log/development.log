  [1m[36mMovie Create (197.7ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "テキサスチェーンソー ビギニング"], ["description", "1939年8月、一人の赤ん坊が食肉処理工場の血まみれの床で生まれた。その子は生まれながらの奇形児で、生肉の包装紙に包まれ、すぐにゴミ箱に捨てられた。たまたまゴミを漁っていた女に拾われた赤ん坊はトーマスと名付けられ、女の家族ヒューイット家で育てられる。  トーマスは6歳のとき、自傷性の変性顔面異常症と診断されるが、その頃から動物を殺して解体するなど異常性が際立っていた。  やがて9歳から食肉処理工場で働き始めた彼は、30歳のとき食肉処理工場が閉鎖されたショックから工場長をハンマーで殴り殺してしまう。住む土地に異常な執着を持つヒューイット家は、逮捕に来た地元の保安官を殺害し、その人肉を食卓に並べた。かくしてヒューイット一家の殺戮が始まった。  ある男女4人が交通事故に合い、内3名が保安官の格好をしたホイト･ヒューイットのパトカーに拘束されヒューイット家の自宅に連れて行かれてしまう。そこには冷酷な殺人鬼と変貌しつつあるレザーフェイス（トーマス）が待ち構えていた。"], ["release_date", "2006-10-05"], ["poster_url", "https://image.tmdb.org/t/p/w500/4msy158ingDkeRvTTflQCtOaL4I.jpg"], ["tmdb_id", 10781], ["created_at", "2024-07-12 16:45:40.294786"], ["updated_at", "2024-07-12 16:45:40.294786"], ["overview", nil], ["poster_path", nil]]
