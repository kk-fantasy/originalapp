  [1m[36mMovie Create (325.4ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "ウルフマン／狼男伝説"], ["description", "地元の医者と研究を続けるダニエルは、狼男の恐ろしい襲撃を目撃する。その野獣の恐ろしい噂を聞きつけてこの小さな村に集まってきた賞金稼ぎやペテン師、そしてスリルを求める人々を見ながら、ダニエルは冷酷なプレデターを倒したいと思い始める。そこでダニエルは、謎めいたよそ者とそのチームの熟練した狼男ハンターたちが怪物を追跡するために村に到着したとき、母親の反対を押し切り、チームに参加したいと申し出る。だがすぐに、この怪物はこれまで彼らが直面してきたもの以上に強く、賢く、危険であることが明らかとなる。犠牲者の数が増え、村人たちは隣人たちが飢えに狂うモンスターに変身させられていくのを目の当たりにする。村人たちは、この狼男の本当の素性を見つけ出すため、互いに武器を手に取り戦う決心をする。そんな興奮状態の中、ダニエルは思いがけず自分が標的のすぐそばにいるのではないかと疑いを抱き始める。"], ["release_date", "2012-10-09"], ["poster_url", "https://image.tmdb.org/t/p/w500/r1EQ7vmw7edPYvNdpk04hFcWM7u.jpg"], ["tmdb_id", 132137], ["created_at", "2024-07-12 18:07:14.943948"], ["updated_at", "2024-07-12 18:07:14.943948"], ["overview", nil], ["poster_path", nil]]
