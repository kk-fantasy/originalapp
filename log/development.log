  [1m[36mMovie Create (197.8ms)[0m  [1m[32mINSERT INTO "movies" ("title", "description", "release_date", "poster_url", "tmdb_id", "created_at", "updated_at", "overview", "poster_path") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "カウントダウン"], ["description", "若者たちが自分の余命がわかるアプリを見つける。スマホにダウンロードし、自分の余命年数で盛り上がるが、その中の一人の女性コートニーの余命は「3時間」と通知が届く。アプリのカウントダウンが「0」になったとき、彼女は想像を絶する恐怖に襲われた!  亡くなったコートニーのボーイフレンドのエヴァンは交通事故を起こし緊急入院。入院直後のエヴァンもアプリの通知の時間通りに謎の死を遂げる。  彼の死に疑問を持った看護師のクイン(エリザベス・ライル)は、生前エヴァンが話していた\"カウントダウン\"のアプリをダウンロードしてしまった。彼女の余命は3日と告げられる……。"], ["release_date", "2019-10-24"], ["poster_url", "https://image.tmdb.org/t/p/w500/5TQ0kM41vWFWFAPbZGitOxDysZU.jpg"], ["tmdb_id", 599975], ["created_at", "2024-07-12 18:05:36.602794"], ["updated_at", "2024-07-12 18:05:36.602794"], ["overview", nil], ["poster_path", nil]]
